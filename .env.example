# ==========================================
# Variables de entorno — AI Project Hub
# ==========================================
# Copia este archivo como .env.local y rellena los valores reales.
#
#   cp .env.example .env.local
#
# .env.local esta en .gitignore: NO se sube a GitHub.
# Este archivo .env.example SI se sube, y solo tiene la estructura.
# ==========================================


# --- Base de datos ---
# Neon / Supabase / PostgreSQL local
# La cadena la copias del panel del proveedor.
# OJO: nunca subes la cadena real, solo esta variable vacia.
DATABASE_URL="postgresql://USUARIO:PASSWORD@HOST/neondb?sslmode=require"


# --- Autenticacion (NextAuth.js v5 / Auth.js) ---
# Obligatoria: firma los tokens de sesion. Minimo 32 caracteres.
# Generala con:  openssl rand -base64 32
# En produccion se configura en las variables de entorno del proveedor (Vercel,
# Railway, etc.), NUNCA se commitea.
AUTH_SECRET=""

# Confianza en el Host de la peticion. Next.js en desarrollo y Vercel ya la
# resuelven solos; activala en cualquier otro despliegue (p. ej. Railway).
AUTH_TRUST_HOST=true

# URL publica de la aplicacion (opcional, NextAuth la infiere en local).
# AUTH_URL="https://tu-dominio.com"

# Proveedores OAuth (opcionales). NextAuth los infiere de AUTH_{PROVIDER}_ID y
# AUTH_{PROVIDER}_SECRET cuando se agreguen a src/lib/auth-config.ts.
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""


# --- Autenticacion (Clerk) --- [LEGACY: migrando a NextAuth.js]
# De https://dashboard.clerk.com -> API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_XXXXXXXXXXXXXXXXXXXXXXXXXXXX"
CLERK_SECRET_KEY="sk_test_XXXXXXXXXXXXXXXXXXXXXXXXXXXX"

# Rutas de Clerk en tu app
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"


# --- Proveedor de IA para el RAG ---
# Vercel AI SDK acepta cualquiera de estos. Ver:
# https://ai-sdk.dev/providers/ai-sdk-providers
#
# OPENAI_API_KEY es OPCIONAL para el chat: sin ella, /api/chat sigue
# respondiendo en modo "context" (busqueda lexica + fuentes) y la indexacion
# devuelve indexed=false en lugar de fallar. Con la clave se usan embeddings
# (text-embedding-3-small) y el LLM (gpt-4o-mini).
AI_GATEWAY_API_KEY=""
OPENAI_API_KEY=""