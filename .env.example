# ==========================================
# Variables de entorno — AI Project Hub
# ==========================================
# Copia este archivo como .env.local y rellena los valores reales.
#
#   cp .env.example .env.local
#
# .env.local esta en .gitignore: NO se sube a GitHub.
# Este archivo .env.example SI se sube, y solo tiene la estructura.
# ==========================================


# --- Base de datos ---
# Neon / Supabase / PostgreSQL local
# La cadena la copias del panel del proveedor.
# OJO: nunca subes la cadena real, solo esta variable vacia.
DATABASE_URL="postgresql://USUARIO:PASSWORD@HOST/neondb?sslmode=require"


# --- Autenticacion (Clerk) ---
# De https://dashboard.clerk.com -> API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_XXXXXXXXXXXXXXXXXXXXXXXXXXXX"
CLERK_SECRET_KEY="sk_test_XXXXXXXXXXXXXXXXXXXXXXXXXXXX"

# Rutas de Clerk en tu app
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"


# --- Proveedor de IA para el RAG ---
# Vercel AI SDK acepta cualquiera de estos. Ver:
# https://ai-sdk.dev/providers/ai-sdk-providers
AI_GATEWAY_API_KEY=""
OPENAI_API_KEY=""